# Backend Environment Variables
# Copy this file to .env for local development
# Set these in Render dashboard for production

# Database
MONGO_URI=mongodb://localhost:27017/test

# JWT & Security
JWT_SECRET=your-jwt-secret-key-change-this-to-random-string
MASTER_KEY=your-master-key-change-this-to-random-string

# Email Configuration (for OTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# MEGA.nz Configuration (for file storage)
MEGA_EMAIL=your-mega-email@gmail.com
MEGA_PASSWORD=your-mega-password

# NLP Service URL
NLP_SUMMARY_URL=http://127.0.0.1:5080/summarize

# Server Configuration
PORT=5000
HOST=127.0.0.1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
